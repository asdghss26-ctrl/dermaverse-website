# Firebase Web App Configuration for Dermverse
#
# Instructions:
# 1. Copy this file to '.env.local':
#      cp .env.example .env.local
# 2. In Firebase Console (https://console.firebase.google.com/):
#      - Open Project: 'dermverse-website'
#      - Navigate to Project Settings -> General -> Your apps -> Web app
#      - Copy your web app config values and replace the placeholders below.
# 3. For Vercel production deployment:
#      - Add these same environment variables in your Vercel Project Settings -> Environment Variables.
#
# NOTE: Never commit '.env.local' or any secret credentials to Git.

NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key-here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="dermverse-website.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dermverse-website"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="dermverse-website.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="122100457772"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id-here"

# Optional: Google Analytics Measurement ID (e.g. G-J4X7HZJDQ9)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
