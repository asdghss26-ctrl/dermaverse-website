rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /appointments/{appointmentId} {
      // 1. Any public patient can submit an appointment request (create only)
      allow create: if request.resource.data.patientName is string
                    && request.resource.data.patientName.size() > 0
                    && request.resource.data.phone is string;

      // 2. Only authenticated clinic staff / doctors can read, update, or delete
      allow read, update, delete: if request.auth != null;
    }
  }
}
